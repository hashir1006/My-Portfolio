{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "build/web",
  "buildCommand": "bash vercel-build.sh",
  "framework": null,
  "routes": [
    {
      "src": "/Resume_Hashir_Shaikh.pdf",
      "dest": "/Resume_Hashir_Shaikh.pdf"
    },
    {
      "src": "/Hashir_Shaikh_Resume.pdf",
      "dest": "/Hashir_Shaikh_Resume.pdf"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
